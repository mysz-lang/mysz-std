fn pub malloc<T>(size: uint): ptr<T> {
    extern fn mysz_malloc<T>(size: uint): ptr<T>;

    return mysz_malloc::<T>(size);
};

fn pub realloc<T>(ptr: ptr<T>, size: uint): ptr<T> {
    extern fn mysz_realloc<T>(ptr: ptr<T>, size: uint): ptr<T>;

    return mysz_realloc::<T>(ptr, size);
};

fn pub calloc<T>(size: uint): ptr<T> {
    extern fn mysz_malloc<T>(size: uint): ptr<T>;
    extern fn mysz_memset<T>(
        ptr: ptr<T>,
        value: int,
        size: uint
    ): ptr<T>;

    var ptr = mysz_malloc::<T>(size);

    return mysz_memset::<T>(ptr, 0, size);
};

fn pub mfree<T>(ptr: ptr<T>): ptr<T> {
    extern fn mysz_free<T>(ptr: ptr<T>): ptr<T>;

    return mysz_free::<T>(ptr);
};

fn pub memcpy<T, K>(
    dest: ptr<T>,
    src: ptr<K>,
    size: uint
): ptr<T> {
    extern fn mysz_memcpy<T, K>(
        dest: ptr<T>,
        src: ptr<K>,
        size: uint
    ): ptr<T>;

    return mysz_memcpy::<T, K>(dest, src, size);
};

fn pub memmove<T, K>(
    dest: ptr<T>,
    src: ptr<K>,
    size: uint
): ptr<T> {
    extern fn mysz_memmove<T, K>(
        dest: ptr<T>,
        src: ptr<K>,
        size: uint
    ): ptr<T>;

    return mysz_memmove::<T, K>(dest, src, size);
};

fn pub memset<T>(
    ptr: ptr<T>,
    value: int,
    size: uint
): ptr<T> {
    extern fn mysz_memset<T>(
        ptr: ptr<T>,
        value: int,
        size: uint
    ): ptr<T>;

    return mysz_memset::<T>(ptr, value, size);
};

fn pub memcmp<T, K>(
    a: ptr<T>,
    b: ptr<K>,
    size: uint
): int {
    extern fn mysz_memcmp<T, K>(
        a: ptr<T>,
        b: ptr<K>,
        size: uint
    ): int;

    return mysz_memcmp::<T, K>(a, b, size);
};