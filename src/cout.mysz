use @::io;
use @::format;
use @::string;

fn pub print(handle: ptr<uint>, args: ...) {
    var i = 0;
    for (arg in args) {
        if (i < args.il) {
            var sarg = sform::<arg>(arg) as ptr<char>;
            write::<char>(handle, sarg, strlen(sarg));
        };
        i = i + 1;
    };
};

fn pub println(handle: ptr<uint>, args: ...) {
    var i = 0;
    for (arg in args) {
        if (i < args.il) {
            print(handle, arg);
        };
        i = i + 1;
    };
    print(handle, "\n");
};