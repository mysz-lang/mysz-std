use @::memory;
use @::string;

fn pub itos(arg: int): str {
    if (arg == 0) {
        return "0";
    };

    var negative = arg < 0;

    if (negative) {
        arg = -arg;
    };

    var digits = 1;
    var n = arg;

    while (n >= 10) {
        n = n / 10;
        digits = digits + 1;
    };

    if (negative) {
        digits = digits + 1;
    };

    var result = malloc::<char>((digits + 1) as uint);

    result[digits] = '\0';

    var i = digits;

    while (arg > 0) {
        i = i - 1;

        var digit = arg % 10;
        result[i] = (digit + 48) as char;

        arg = arg / 10;
    };

    if (negative) {
        result[0] = '-' as char;
    };

    return result as str;
};

fn pub sform<T>(arg: T): str {
    if (typeof(T) == "str") {
        return arg;
    };

    if (typeof(T) == "int" || typeof(T) == "uint" || typeof(T) == "i8" || typeof(T) == "u8") {
        return itos(arg as int);
    };

    if (typeof(T) == "char") {
        var result: str = malloc::<char>(2) as str;
        result[0] = arg;
        result[1] = '\0';
        return result;
    };

    if (typeof(T) == "nil") {
        return "{0}";
    };

    return "unknown";
};