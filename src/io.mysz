fn pub stdin(): ptr<uint> {
    extern fn mysz_stdin(): ptr<uint>;

    return mysz_stdin();
};

fn pub stdout(): ptr<uint> {
    extern fn mysz_stdout(): ptr<uint>;

    return mysz_stdout();
};

fn pub stderr(): ptr<uint> {
    extern fn mysz_stderr(): ptr<uint>;

    return mysz_stderr();
};

fn pub read<T>(
    handle: ptr<uint>,
    buffer: ptr<T>,
    size: uint
): uint {
    extern fn mysz_read<T>(
        handle: ptr<uint>,
        buffer: ptr<T>,
        size: uint
    ): uint;

    return mysz_read::<T>(handle, buffer, size);
};

fn pub write<T>(
    handle: ptr<uint>,
    buffer: ptr<T>,
    size: uint
): uint {
    extern fn mysz_write<T>(
        handle: ptr<uint>,
        buffer: ptr<T>,
        size: uint
    ): uint;

    return mysz_write::<T>(handle, buffer, size);
};

fn pub seek(
    handle: ptr<uint>,
    offset: int,
    whence: int
): int {
    extern fn mysz_seek(
        handle: ptr<uint>,
        offset: int,
        whence: int
    ): int;

    return mysz_seek(handle, offset, whence);
};

fn pub close(handle: ptr<uint>): ptr<uint> {
    extern fn mysz_close(handle: ptr<uint>): ptr<uint>;

    return mysz_close(handle);
};